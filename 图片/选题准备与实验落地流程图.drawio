<mxfile host="app.diagrams.net" modified="2026-10-26T00:00:00.000Z" agent="QwenWork" version="24.7.17" type="device">
  <diagram id="research-roadmap" name="选题准备与实验落地流程图">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="从导师选题汇报到论文实验落地：你要怎么做、每一步做什么" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#263238;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="1400" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="legend" value="图例：蓝色＝执行任务　黄色＝确认/决策　绿色＝阶段产出　红色＝风险与降级" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eceff1;strokeColor=#78909c;fontSize=12;fontColor=#455a64;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="720" y="75" width="660" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="now-group" value="A. 现在到第一次导师汇报：先把问题讲清楚，不急着训练模型" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontStyle=1;fontSize=17;fillColor=#fafafa;strokeColor=#8d6e63;strokeWidth=2;container=1;collapsible=0;fontColor=#4e342e;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="1980" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="learn" value="1　学会讲主线&#xa;研究对象、未来5日标签&#xa;LLM / GRU / GraphSAGE 分工&#xa;共同冲击 ≠ 因果传染" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="now-group">
          <mxGeometry x="60" y="65" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="read" value="2　按顺序看材料&#xa;逐页讲解稿 → 汇报PPT&#xa;AAAI 2025 DGNN-SR&#xa;ACL 2024 EFSA → 辅助论文" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="now-group">
          <mxGeometry x="440" y="65" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="prepare" value="3　准备汇报材料&#xa;15页PPT + 一句话摘要&#xa;母论文迁移对照表&#xa;一个完整公告示例" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="now-group">
          <mxGeometry x="820" y="65" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ask" value="4　请导师拍板&#xa;题目与任务边界是否合适？&#xa;DGNN-SR能否作为母论文？&#xa;最低交付与扩展分别是什么？" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=3;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="now-group">
          <mxGeometry x="1200" y="65" width="330" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="meeting-output" value="阶段产出&#xa;导师意见原话 + 暂定题目&#xa;认可项 / 质疑项 / 否定项&#xa;学校模板与截止时间" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="now-group">
          <mxGeometry x="1580" y="65" width="330" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="e-learn-read" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="learn" target="read" parent="now-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-read-prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="read" target="prepare" parent="now-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-prepare-ask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="prepare" target="ask" parent="now-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-ask-output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="ask" target="meeting-output" parent="now-group"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="audit-group" value="B. 数据可行性闸门：先导出少量样例，再决定模型能不能做" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontStyle=1;fontSize=17;fillColor=#fafafa;strokeColor=#00838f;strokeWidth=2;container=1;collapsible=0;fontColor=#006064;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="1980" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="sample-event" value="事件样例 20–50 条&#xa;正文 / 描述可读吗？&#xa;有实际发布时间吗？&#xa;有原因和数值字段吗？" style="shape=mxgraph.flowchart.document;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="50" y="70" width="300" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="sample-share" value="股东与股本样例&#xa;名称 / 类型 / 持股比例&#xa;实际公告日 / 报告期&#xa;Top10 还是全部股东？" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="390" y="70" width="300" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="sample-market" value="行情与因子样例&#xa;日频覆盖年份 / 复权口径&#xa;停牌处理 / 行业指数&#xa;MKT · SMB · HML · MOM" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0f7fa;strokeColor=#00838f;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="730" y="70" width="300" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="feasible" value="关键字段足够？&#xa;时间上能严格按“当时可得”对齐？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fce4b8;strokeColor=#c77700;strokeWidth=3;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="1100" y="75" width="270" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="freeze" value="是：冻结研究口径&#xa;样本范围 / 预测窗口 / 标签&#xa;事件字段 / 股东图规则&#xa;最低可交付模型" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=14;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="1430" y="70" width="300" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="fallback" value="否：立即降级，不堆模型&#xa;无正文 → 结构化事件标准化；图过稀 → 股东图作为辅助&#xa;时间缺失 → 下一交易日生效并披露限制" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="audit-group">
          <mxGeometry x="960" y="220" width="560" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e-event-share" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1976d2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="sample-event" target="sample-share" parent="audit-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-share-market" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7b1fa2;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="sample-share" target="sample-market" parent="audit-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-market-decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#00838f;strokeWidth=2;endArrow=block;endFill=1;" edge="1" source="sample-market" target="feasible" parent="audit-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-yes-freeze" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2e7d32;strokeWidth=3;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontFamily=PingFang SC;" edge="1" source="feasible" target="freeze" parent="audit-group"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-no-fallback" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c62828;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=12;fontStyle=1;fontFamily=PingFang SC;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="feasible" target="fallback" parent="audit-group"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="implementation-group" value="C. 正式实施主流程：每一步都要有可检查的产出" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontStyle=1;fontSize=17;fillColor=#fafafa;strokeColor=#5d4037;strokeWidth=2;container=1;collapsible=0;fontColor=#4e342e;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="60" y="770" width="1980" height="370" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="阶段 1　数据审计&#xa;核对字段与生效时间&#xa;统计文本、图密度、正例率" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="35" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="阶段 2　标签构造&#xa;滚动因子回归&#xa;未来5日残差 CAR&#xa;历史10%分位标签" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="275" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="阶段 3　事件标注&#xa;试标300条 → 冻结规范&#xa;扩展到1000–1500条&#xa;双人复核 + 裁决" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="515" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="阶段 4　事件抽取&#xa;规则 / BERT / Qwen基线&#xa;Qwen3-8B QLoRA&#xa;冻结并缓存历史事件" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="755" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="阶段 5　基础模型&#xa;历史频率 / Logistic&#xa;XGBoost / 无图 GRU&#xa;先建立可靠下限" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="995" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="阶段 6　融合模型&#xa;GRU + 事件时间注意力&#xa;共同股东 GraphSAGE&#xa;简单拼接 vs 门控" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="1235" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="阶段 7　样本外评价&#xa;walk-forward + 防泄漏&#xa;基线 / 消融 / 替代图&#xa;区块 Bootstrap" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="1475" y="80" width="205" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s8" value="阶段 8　论文写作&#xa;报告抽取质量与下游增益&#xa;写清失败结果与局限&#xa;不做因果传染结论" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=3;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="implementation-group">
          <mxGeometry x="1715" y="80" width="205" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="o1" value="产出：字段表 + 时间规则 + 三类描述统计" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="35" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o2" value="产出：可复算标签 + 年度/行业正例分布" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="275" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o3" value="产出：标注规范 + 一致性 + 人工测试集" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="515" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o4" value="产出：模型权重/配置 + JSON缓存 + 抽取指标" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="755" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o5" value="产出：统一测试日期上的基线结果" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="995" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o6" value="产出：完整模型 + 各模块贡献" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="1235" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o7" value="产出：PR-AUC等指标 + 置信区间" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="1475" y="225" width="205" height="65" as="geometry"/></mxCell>
        <mxCell id="o8" value="产出：开题/中期/论文稿 + 可复现实验记录" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=11;fontFamily=PingFang SC;" vertex="1" parent="implementation-group"><mxGeometry x="1715" y="225" width="205" height="65" as="geometry"/></mxCell>

