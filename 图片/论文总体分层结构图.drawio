  <diagram id="thesis-layered-structure" name="论文总体分层结构图">
    <mxGraphModel dx="1800" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="基于大语言模型事件表征与时变股东关系的上市公司尾部风险预测" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#263238;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="1210" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="总体分层结构：数据可得性 → 三路编码 → 门控融合 → 未来5日尾部风险 → 双层评价" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#546e7a;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="1050" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="target" value="研究目标&#xa;预测上市公司未来 5 个交易日是否发生因子模型下的异常下跌" style="rounded=1;whiteSpace=wrap;html=1;arcSize=18;fillColor=#fff9c4;strokeColor=#f57f17;strokeWidth=3;fontSize=16;fontStyle=1;fontColor=#5d4037;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="520" y="105" width="610" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="boundary" value="研究边界：检验样本外预测增益，不直接声称识别因果传染" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=15;fillColor=#ffebee;strokeColor=#c62828;fontSize=12;fontStyle=1;fontColor=#b71c1c;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1190" y="105" width="340" height="75" as="geometry"/>
        </mxCell>

        <mxCell id="data-group" value="第 1 层　RESSET 数据与时点治理" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontStyle=1;fontSize=16;fillColor=#fafafa;strokeColor=#8d6e63;strokeWidth=2;container=1;collapsible=0;fontColor=#4e342e;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="60" y="215" width="1530" height="200" as="geometry"/>
