          <mxGeometry x="35" y="60" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="market-data" value="行情与公司状态&#xa;残差收益 · 波动率 · 换手率&#xa;成交量 · 市值 · 财务 · ST" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e0f7fa;strokeColor=#00838f;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="data-group">
          <mxGeometry x="405" y="60" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="share-data" value="股东与股本披露&#xa;股东名称 / 类型 / 持股比例&#xa;报告期 / 实际公告时间" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f3e5f5;strokeColor=#7b1fa2;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="data-group">
          <mxGeometry x="775" y="60" width="300" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="factor-data" value="共同因素与标签数据&#xa;MKT · SMB · HML · MOM&#xa;行业 / 无风险收益 / 交易日&#xa;仅用于构造历史标签" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#fce4b8;strokeColor=#c77700;strokeWidth=2;fontSize=13;fontStyle=1;fontFamily=PingFang SC;" vertex="1" parent="data-group">
          <mxGeometry x="1145" y="60" width="300" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="time-rule" value="统一可得性规则：只使用预测时点 t 已公开的信息；盘后或缺少时分秒的公告从下一交易日生效；标准化、阈值和图参数只由训练历史确定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff3e0;strokeColor=#e65100;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#bf360c;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="290" y="445" width="1070" height="65" as="geometry"/>
