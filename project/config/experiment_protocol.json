{
  "version": "actual-loss-four-bin-v1-2026-11-26",
  "title": "基于多维时序数据融合的短期证券市场风险预测",
  "prediction_unit": "as_of_listed_A_share_market_day",
  "research_start": "2017-01-01",
  "research_end": "2024-07-24",
  "outcome_input_end": "2024-07-31",
  "target": {
    "source_field": "Dret",
    "definition": "product(1 + raw stock return at each next five market sessions) - 1",
    "horizon_market_sessions": 5,
    "primary_loss_threshold": -0.05,
    "severe_loss_threshold": -0.10,
    "loss_bins": ["R5 >= 0", "-0.05 < R5 < 0", "-0.10 < R5 <= -0.05", "R5 <= -0.10"],
    "label_fields": ["loss_bin", "label_loss", "label_loss_5pct", "label_loss_10pct"],
    "no_factor_or_industry_subtraction": true,
    "no_252_regression_or_completed_outcome_warmup": true,
    "return_convention_certified": false,
    "historical_universe_certified": false,
    "missing_outcome": "nullable_unknown_not_negative_and_not_prediction_eligibility",
    "prediction_universe": "historical_identity_as_of_t; observed-only candidate until certified",
    "suspension": "zero_valuation_return_only_with_documented_authoritative_convention",
    "delisting": "dated_terminal_value_or_conversion_only; disappearance_not_zero_or_minus_100_percent",
    "retired_primary": "FF3 residual P10 remains historical diagnostic evidence only"
  },
  "seeds": [42, 2024, 7, 123, 3407],
  "sequence_sessions": 60,
  "event_sessions": 60,
  "max_events": 8,
  "date_only_disclosure": "next_market_session",
  "model": {
    "name": "context_conditioned_reliability_probability_mixture",
    "stock_gru_dimension": 64,
    "market_gru_dimension": 32,
    "sector_gru_dimension": 32,
    "price_context_dimension": 128,
    "event_dimension": 128,
    "graph_dimension": 128,
    "expert_output": "four_bin_softmax",
    "event_attention": "price_context_query",
    "graph_messages": "price_and_available_event_states; leave_destination_company_out",
    "graph_available": "positive_weight_certified_shared_peer",
    "main_share_basis": "pct_total",
    "aux_weight": "u_m = M_m Q_m exp(-softplus(lambda_m) A_m) sigmoid(G_m)",
    "mixture": "g=1-(1-u_e)(1-u_g); alpha_s=1-g; alpha_m=g*u_m/(u_e+u_g); zero sum -> alpha_s=1",
    "same_weights_all_loss_bins": true,
    "primary_loss": "four_bin_mixture_NLL",
    "class_weighting": false,
    "primary_branch_auxiliary_loss": false,
    "modality_dropout_training_only": 0.1,
    "quality": "inferable_body_source_JSON_evidence_traceability_not_test_gold_or_self_report",
    "same_information_context": "historical_market_sector_price_context_plus_common_lawsuit_controls",
    "features_assembled": false
  },
  "folds": [
    {"name":"2021","train_end":"2019-12-31","selection_start":"2020-01-01","selection_end":"2020-08-31","calibration_start":"2020-09-01","calibration_end":"2020-12-31","validation_start":"2020-01-01","validation_end":"2020-12-31","test_start":"2021-01-01","test_end":"2021-12-31"},
    {"name":"2022","train_end":"2020-12-31","selection_start":"2021-01-01","selection_end":"2021-08-31","calibration_start":"2021-09-01","calibration_end":"2021-12-31","validation_start":"2021-01-01","validation_end":"2021-12-31","test_start":"2022-01-01","test_end":"2022-12-31"},
    {"name":"2023","train_end":"2021-12-31","selection_start":"2022-01-01","selection_end":"2022-08-31","calibration_start":"2022-09-01","calibration_end":"2022-12-31","validation_start":"2022-01-01","validation_end":"2022-12-31","test_start":"2023-01-01","test_end":"2023-12-31"},
    {"name":"2024-partial","train_end":"2022-12-31","selection_start":"2023-01-01","selection_end":"2023-08-31","calibration_start":"2023-09-01","calibration_end":"2023-12-31","validation_start":"2023-01-01","validation_end":"2023-12-31","test_start":"2024-01-01","test_end":"2024-07-24"}
  ],
  "purge_rule": "outcome_end_before_next_actual_market_session_at_train_selection_calibration_test_boundaries",
  "selection": "per_fold_selection_seed_mean_AP_loss_5pct_excluding_M",
  "calibration": "final_joint_bin_positive_temperature_on_later_calibration_slice",
  "alert_threshold": "chosen_on_calibration_data_with_explicit_false_alarm_recall_tradeoff_not_test",
  "primary_metric": "AP_loss_5pct",
  "secondary_metrics": ["NLL", "Brier", "calibration", "precision", "recall", "FNR", "loss_10pct", "ordinary_loss", "expected_member_loss_fraction"],
  "daily_top_fraction": 0.1,
  "daily_top_role": "secondary_capacity_metric_rank_entire_prediction_universe_before_outcome_filter",
  "seed_aggregation": "mean_seed_metrics_not_probability_ensemble_metrics",
  "fold_aggregation": "equal_weight_mean",
  "bootstrap_method": "moving_block_paired_whole_market_dates_within_fold",
  "primary_block_sessions": 20,
  "sensitivity_block_sessions": [5, 60],
  "bootstrap_repeats": 1000,
  "aggregate_warning": "mean_calibrated_member_p5_p10_is_expected_member_fraction_not_index_crash_probability",
  "unknown_outcome_fraction_bounds": "[known_positive/N, (known_positive+unknown)/N]",
  "controls": ["price_context", "transparent_return_statistics_logit", "same_information_strong_trees", "same_encoder_concat", "same_encoder_ordinary_gate", "same_encoder_standard_probability_mixture"],
  "ablations": ["no_explicit_market_information", "no_explicit_sector_information", "no_earnings_event", "no_holdings_graph", "no_quality_filter_or_gate", "no_age_attention_edge_or_gate", "context_independent_event_attention", "degree_sector_preserving_graph_rewire"],
  "same_information_text_control": "same_frozen_event_vectors_train_only_PCA64",
  "annotation": {"pilot":200,"total":1500,"double":300,"train":800,"validation":200,"test":500,"pilot_is_training_subset":true,"double_is_total_subset":true,"train_years":[2017,2018,2019],"validation_year":2020,"test_start_year":2021},
  "qwen": {"base_model":"Qwen/Qwen3-8B","quantization":"4bit_nf4","lora_rank":16,"lora_alpha":32,"lora_dropout":0.05,"max_total_tokens":2048,"initial_body_budget_tokens":1024,"batch_size":1,"gradient_accumulation":16},
  "formal_model_training_completed": false
}
